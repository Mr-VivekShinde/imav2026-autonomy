<?xml version="1.0" ?>
<sdf version="1.9">
<model name="landing_platform">

  <link name="base">
    <inertial>
      <mass>1.0</mass>
      <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
    </inertial>
    <visual name="rail_visual">
      <geometry><box><size>1 0.05 0.05</size></box></geometry>
    </visual>
    <collision name="rail_collision">
      <geometry><box><size>1 0.05 0.05</size></box></geometry>
    </collision>
  </link>

  <joint name="world_fixed" type="fixed">
    <parent>world</parent>
    <child>base</child>
  </joint>

  <link name="slider">
    <pose>0 0 0.1 0 0 0</pose>
    <inertial>
      <mass>1.0</mass>
      <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
    </inertial>
    <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://landing_platform/meshes/aruco_plate.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://landing_platform/materials/textures/aruco_id1.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

  <collision name="collision">
    <geometry>
      <box>
          <size>0.5 0.5 0.05</size>
      </box>
    </geometry>
  </collision>
  </link>

  <joint name="slider_joint" type="prismatic">
    <parent>base</parent>
    <child>slider</child>
    <axis>
      <xyz>1 0 0</xyz>
      <limit>
        <lower>-0.5</lower>
        <upper>0.5</upper>
        <velocity>0.1</velocity>
        <effort>100000</effort>
      </limit>
      <dynamics>
        <damping>0.5</damping>
      </dynamics>
    </axis>
  </joint>

  <plugin
    filename="gz-sim-joint-controller-system"
    name="gz::sim::systems::JointController">
    <joint_name>slider_joint</joint_name>
    <type>velocity</type>
    <topic>/slider/cmd_vel</topic>
    <use_force_commands>true</use_force_commands>
    <p_gain>200</p_gain>
    <i_gain>0.5</i_gain>
    <d_gain>20</d_gain>
  </plugin>

</model>
</sdf>