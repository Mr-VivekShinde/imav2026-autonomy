# ArUco Plate 50x50cm
# UV-mapped so the top face shows the ArUco texture
mtllib aruco_plate.mtl

# Vertices: 0.5m x 0.5m, 0.002m thick
# Bottom face vertices
v -0.25 -0.25 0.0
v  0.25 -0.25 0.0
v  0.25  0.25 0.0
v -0.25  0.25 0.0
# Top face vertices
v -0.25 -0.25 0.002
v  0.25 -0.25 0.002
v  0.25  0.25 0.002
v -0.25  0.25 0.002

# UV coordinates for top face (ArUco texture)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0  0  1
vn  0  0 -1
vn  0 -1  0
vn  0  1  0
vn -1  0  0
vn  1  0  0

usemtl aruco_texture

# Top face (ArUco texture, CCW from above)
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1

usemtl white

# Bottom face
f 4/4/2 3/3/2 2/2/2
f 4/4/2 2/2/2 1/1/2

# Front face
f 1/1/3 2/2/3 6/3/3
f 1/1/3 6/3/3 5/4/3

# Back face
f 3/1/4 4/2/4 8/3/4
f 3/1/4 8/3/4 7/4/4

# Left face
f 4/1/5 1/2/5 5/3/5
f 4/1/5 5/3/5 8/4/5

# Right face
f 2/1/6 3/2/6 7/3/6
f 2/1/6 7/3/6 6/4/6
