<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>

  <model name='MLX90614'>

    <link name="MLX90614_link">
    <inertial>
        <pose>0.00358 -0.03 .014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000055421</iyy>
          <iyz>0</iyz>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
    <collision name="collision">
      <geometry>
        <mesh>
            <uri>model://MLX90614/meshes/MLX90614.stl</uri>
          </mesh>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <mesh>
            <uri>model://MLX90614/meshes/MLX90614.stl</uri>
          </mesh>
      </geometry>
    </visual>
    <sensor name="camera_thermal" type="thermal_camera">
      <pose>0 0 0 0 1.5708 0</pose>  
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>

      <topic>/MLX90614/thermal_image</topic>

      <thermal_camera>
        <horizontal_fov>0.611</horizontal_fov> <!-- 35° in Radiant -->
        <image>
          <width>320</width>
          <height>240</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20</far>
        </clip>
        
        <min_temp>203.15</min_temp>       <!-- -70°C -->
        <max_temp>653.15</max_temp>       <!-- 380°C -->
        <resolution>0.01</resolution>     <!-- 0.01 K Auflösung -->
      </thermal_camera>
    </sensor>
  
  </link>
</model>
</sdf>